    {
      "id": "p0",
      "nom": {
        "fr": "Le panneau de bienvenue",
        "en": "The welcome sign",
        "es": "El panel de bienvenida"
      },
      "lat": 44.99414,
      "lon": 1.25383,
      "deverrouillage": "gps",
      "photo": "sg_totem_00_bienvenue_plan.jpg",
      "consigne_trajet": {
        "fr": "Garez-vous sur l'aire du lavoir et approchez-vous du grand panneau « Bienvenue ».",
        "en": "Park at the wash-house car park and walk up to the big 'Bienvenue' sign.",
        "es": "Aparcad en el área del lavadero y acercaos al gran panel «Bienvenue»."
      },
      "recit": {
        "fr": "Voyageurs, avant de me rencontrer, prouvez-moi que vous savez lire ce pays. Ce panneau montre toute la balade du village.",
        "en": "Travellers, before you meet me, prove that you can read this land. This sign shows the whole village trail.",
        "es": "Viajeros, antes de conocerme, demostradme que sabéis leer esta tierra. Este panel muestra todo el paseo del pueblo."
      },
      "type": "code",
      "question": {
        "fr": "Combien de stations numérotées compte la balade patrimoine ? (en chiffres)",
        "en": "How many numbered stations does the heritage trail have? (in digits)",
        "es": "¿Cuántas estaciones numeradas tiene el paseo patrimonial? (en cifras)"
      },
      "reponses": [
        "12",
        "douze",
        "twelve",
        "doce"
      ],
      "indices": [
        {
          "fr": "Comptez les numéros dans la liste du panneau.",
          "en": "Count the numbers in the list on the sign.",
          "es": "Contad los números de la lista del panel."
        },
        {
          "fr": "La dernière station, ce sont les écoles.",
          "en": "The last station is the schools.",
          "es": "La última estación son las escuelas."
        }
      ],
      "apres": {
        "fr": "Douze. Vous savez compter, c'est un début. Descendez maintenant vers le lavoir, au bord de l'eau.",
        "en": "Twelve. You can count, that is a start. Now go down to the wash-house, by the water.",
        "es": "Doce. Sabéis contar, ya es algo. Bajad ahora al lavadero, junto al agua."
      }
    },
    {
      "id": "p1",
      "nom": {
        "fr": "L'eau de neige",
        "en": "The snow water",
        "es": "El agua de nieve"
      },
      "lat": 44.99406,
      "lon": 1.25408,
      "deverrouillage": "gps",
      "photo": "sg_totem_01_eau_1.jpg",
      "consigne_trajet": {
        "fr": "Rejoignez le totem « Les usages de l'eau », à côté du lavoir.",
        "en": "Go to the 'Les usages de l'eau' (uses of water) post next to the wash-house.",
        "es": "Id al tótem «Les usages de l'eau» (los usos del agua), junto al lavadero."
      },
      "recit": {
        "fr": "Ici, les lavandières frappaient le linge à genoux. Et dans ce village, une femme savait soigner les brûlures avec une étrange eau de neige.",
        "en": "Here the washerwomen beat the linen on their knees. And in this village, one woman could heal burns with a strange snow water.",
        "es": "Aquí las lavanderas golpeaban la ropa de rodillas. Y en este pueblo, una mujer sabía curar las quemaduras con una extraña agua de nieve."
      },
      "type": "texte",
      "question": {
        "fr": "Soulevez les clapets : quel est le prénom de celle qui savait « enlever le feu » ?",
        "en": "Lift the flaps: what was the first name of the woman who could 'take the fire away'?",
        "es": "Levantad las solapas: ¿cuál era el nombre de la mujer que sabía «quitar el fuego»?"
      },
      "reponses": [
        "honorine"
      ],
      "indices": [
        {
          "fr": "Cherchez le clapet « L'eau de neige miraculeuse ».",
          "en": "Look for the flap 'L'eau de neige miraculeuse'.",
          "es": "Buscad la solapa «L'eau de neige miraculeuse»."
        },
        {
          "fr": "Son prénom commence par HONO…",
          "en": "Her name starts with HONO…",
          "es": "Su nombre empieza por HONO…"
        }
      ],
      "apres": {
        "fr": "Honorine. Les guérisseurs gardaient leurs secrets, comme moi le mien. Regardez maintenant le panneau du train, juste à côté.",
        "en": "Honorine. Healers kept their secrets, as I keep mine. Now look at the railway sign, right next to it.",
        "es": "Honorine. Los curanderos guardaban sus secretos, como yo el mío. Mirad ahora el panel del tren, justo al lado."
      }
    },
